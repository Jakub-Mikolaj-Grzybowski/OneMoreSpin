# Budowanie frontendu
FROM node:20-alpine AS build

WORKDIR /app

COPY ["OneMoreSpin.Frontend/onemorespin-ui/package.json", "OneMoreSpin.Frontend/onemorespin-ui/package-lock.json", "./"]
RUN npm ci
COPY "OneMoreSpin.Frontend/onemorespin-ui/" .

ARG VITE_API_BASE=https://onemorespin.jakubg.org/api
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

# Serwowanie statycznego buildu
FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY OneMoreSpin.Frontend/onemorespin-ui/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80